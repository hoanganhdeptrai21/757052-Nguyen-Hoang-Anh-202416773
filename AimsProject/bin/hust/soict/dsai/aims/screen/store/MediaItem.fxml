<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="5"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hust.soict.dsai.aims.screen.store.MediaItemController"
      style="-fx-border-color: #cccccc; -fx-padding: 10; -fx-background-color: #f9f9f9;">

    <Label fx:id="lblTitle" style="-fx-font-weight: bold;"/>
    <Label fx:id="lblCategory"/>
    <Label fx:id="lblCost"/>

    <HBox spacing="5">
        <Button fx:id="btnAdd"  text="Add to Cart" onAction="#addToCart"/>
        <Button fx:id="btnPlay" text="Play"       onAction="#playMedia"/>
    </HBox>

</VBox>
