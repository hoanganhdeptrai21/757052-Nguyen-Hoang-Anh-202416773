<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hust.soict.dsai.aims.screen.store.StoreScreenController">

    <top>
        <HBox alignment="CENTER_RIGHT"
              spacing="10"
              style="-fx-padding: 10; -fx-background-color: #333333;">
            <children>
                <Label text="AIMS STORE"
                       style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;"
                       HBox.hgrow="ALWAYS"/>
                <Button text="View Cart" onAction="#viewCart"/>
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <FlowPane fx:id="flowPane"
                          hgap="15" vgap="15"
                          style="-fx-padding: 20;"/>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
